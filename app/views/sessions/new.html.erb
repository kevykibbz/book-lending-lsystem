<div class="flex items-center justify-center min-h-screen bg-gray-100">
  <div class="w-full max-w-md bg-white p-6 rounded-lg shadow-md">
    <h1 class="text-2xl font-bold text-gray-800 mb-6 text-center">Sign In</h1>
   
   <!-- Flash Messages -->
    <% if flash.now[:alert] || flash[:alert] %>
      <div class="mb-4 text-sm text-red-600 bg-red-100 p-3 rounded-md">
        <%= flash.now[:alert] || flash[:alert] %>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div class="mb-4 text-sm text-green-600 bg-green-100 p-3 rounded-md">
        <%= flash[:notice] %>
      </div>
    <% end %>



    <!-- Login Form -->
    <%= form_with url: session_path, class: "space-y-4" do |form| %>

      <div>
        <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username",
          placeholder: "Enter your email address",
          value: params[:email],
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= form.password_field :password, required: true, autocomplete: "current-password",
          placeholder: "Enter your password", maxlength: 72,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= form.submit "Sign in", class: "w-full cursor-pointer bg-gray-900 text-white py-2 px-4 rounded-lg shadow-md hover:bg-blue-700 transition" %>
      </div>

    <% end %>

    <!-- Forgot Password Link -->
    <p class="text-center text-gray-600 mt-4">
      <%= link_to "Forgot password?", new_password_path, class: "text-blue-600 hover:underline" %>
    </p>

  </div>
</div>
