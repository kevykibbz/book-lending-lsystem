<div class="max-w-md mx-auto bg-white p-8 rounded-lg shadow-md mt-10">
  <h1 class="text-2xl font-bold text-gray-800 mb-6 text-center">Sign Up</h1>

  <%= form_with model: @user, url: user_path, class: "space-y-4" do |form| %>

    <div>
      <%= form.label :full_name, "Full Name", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :full_name, required: true, class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      <% if @user.errors[:full_name].any? %>
        <p class="text-sm text-red-500 mt-1"><%= @user.errors[:full_name].join(", ") %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :email, "Email Address", class: "block text-sm font-medium text-gray-700" %>
      <%= form.email_field :email, required: true, class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      <% if @user.errors[:email].any? %>
        <p class="text-sm text-red-500 mt-1"><%= @user.errors[:email].join(", ") %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :password, "Password", class: "block text-sm font-medium text-gray-700" %>
      <%= form.password_field :password, required: true, class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      <% if @user.errors[:password].any? %>
        <p class="text-sm text-red-500 mt-1"><%= @user.errors[:password].join(", ") %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-700" %>
      <%= form.password_field :password_confirmation, required: true, class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      <% if @user.errors[:password_confirmation].any? %>
        <p class="text-sm text-red-500 mt-1"><%= @user.errors[:password_confirmation].join(", ") %></p>
      <% end %>
    </div>

    <div>
      <%= form.submit "Sign Up", class: "w-full bg-gray-800 text-white py-2 cursor-pointer px-4 rounded-lg shadow-md hover:bg-blue-700 transition" %>
    </div>

  <% end %>

  <p class="text-center text-gray-600 mt-4">
    Already have an account? <%= link_to "Log in", new_session_path, class: "text-blue-600 hover:underline" %>
  </p>
</div>
