<div class="container mx-auto p-6">
 <!-- User Profile Information -->
  <div class="mb-8">
    <h2 class="font-bold text-2xl mb-2">Profile Information</h2>
    <div class="bg-white p-6 rounded-lg shadow-md">
      <% if @user.full_name.present? %><p class="text-gray-700"><strong>Name:</strong> <%= @user.full_name %></p><% end %>
      <p class="text-gray-700"><strong>Email:</strong> <%= @user.email %></p>
    </div>
  </div>

  <div class="bg-white p-6 rounded-lg shadow-md">
   <h1 class="font-bold text-4xl mb-6">My Borrowed Books</h1>
  <% if flash[:notice] %>
      <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded">
        <%= flash[:notice] %>
      </div>
    <% end %>
  <% if @user.borrowings.any? %>
    <table class="table-auto w-full border-collapse border border-gray-200 shadow-lg">
      <thead class="bg-gray-100">
        <tr>
          <th class="border p-3">Title</th>
          <th class="border p-3">Author</th>
          <th class="border p-3">ISBN</th>
          <th class="border p-3">Due Date</th>
          <th class="border p-3">Action</th>
        </tr>
      </thead>
      <tbody>
        <% @user.borrowings.each do |borrowing| %>
          <tr class="text-center bg-white hover:bg-gray-50">
            <td class="border p-3"><%= borrowing.book.title %></td>
            <td class="border p-3"><%= borrowing.book.author %></td>
            <td class="border p-3"><%= borrowing.book.isbn %></td>
            <td class="border p-3 text-red-500 font-semibold"><%= borrowing.due_date.strftime("%B %d, %Y") %></td>
            <td class="border p-3">
              <%= button_to "Return", borrowing_path(borrowing), method: :delete, class: "cursor-pointer bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-600 mt-4">You haven't borrowed any books yet.</p>
  <% end %>
  <div class="mt-6">
    <%= link_to "Back to Books", books_path, class: "text-blue-600 hover:underline" %>
  </div>
  </div>

</div>
