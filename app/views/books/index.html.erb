<div class="container mx-auto mb-5">
<h1 class="text-2xl font-bold mb-4">Books</h1>
<% if flash[:notice] %>
    <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded">
      <%= flash[:notice] %>
    </div>
  <% end %>
<table class="w-full border-collapse border border-gray-300 shadow-lg">
  <thead>
    <tr class="bg-gray-100 text-left">
      <th class="border p-2">Title</th>
      <th class="border p-2">Author</th>
      <th class="border p-2">ISBN</th>
      <th class="border p-2">Availability</th>
      <th class="border p-2">Action</th>
    </tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr class="border hover:bg-gray-50">
        <td class="border p-2">
          <%= link_to book.title, book_path(book), class: "text-blue-600 hover:underline" %>
        </td>
        <td class="border p-2"><%= book.author %></td>
        <td class="border p-2"><%= book.isbn %></td>
        <td class="border p-2">
          <% if book.borrowed? %>
            <span class="text-red-500">Not Available</span>
          <% else %>
            <span class="text-green-500">Available</span>
          <% end %>
        </td>
        <td class="border p-2">
          <% if current_user.present? %> <%# Check if user is logged in %>
            <% if book.borrowed? %>
              <button class="bg-gray-400 text-white px-4 py-2 rounded cursor-not-allowed" disabled>Borrowed</button>
            <% else %>
              <%= button_to "Borrow", borrowings_path(book_id: book.id), method: :post, class: "cursor-pointer bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded", id: "borrow-button-#{book.id}" %>            <% end %>
          <% else %>
              <button class="bg-gray-400 text-white px-4 py-2 rounded cursor-not-allowed" disabled>Borrow</button>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

</div>