<footer class="bg-gray-900 text-white py-6">
  <div class="container mx-auto   px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
      
      <!-- Logo & Description -->
      <div>
        <h2 class="text-2xl font-bold">Book Library</h2>
        <p class="text-gray-400 mt-2">Your go-to place for books and knowledge.</p>
      </div>
      
      <!-- Navigation Links -->
      <div>
        <h3 class="text-lg font-semibold">Quick Links</h3>
        <ul class="mt-2 space-y-2">
          <li><%= link_to "Home", root_path, class: "hover:text-gray-400" %></li>
            <li><a href="#" class="hover:underline">About</a></li>
            <li><a href="#" class="hover:underline">Contact Us</a></li>
            <li><%= link_to "Books", books_path, class: "hover:underline" %></li>

        </ul>
      </div>

      <!-- Social Media Links -->
      <div>
        <h3 class="text-lg font-semibold">Follow Us</h3>
        <div class="flex justify-center md:justify-start mt-3 space-x-4">
          <%= link_to "#", class: "text-gray-400 hover:text-white" do %>
            facebook
          <% end %>
          <%= link_to "#", class: "text-gray-400 hover:text-white" do %>
            twitter
          <% end %>
          <%= link_to "#", class: "text-gray-400 hover:text-white" do %>
          instagram
          <% end %>
          <%= link_to "#", class: "text-gray-400 hover:text-white" do %>
          linkedin
          <% end %>
        </div>
      </div>
      
    </div>

    <!-- Copyright -->
    <div class="border-t border-gray-700 mt-6 pt-4 text-center text-sm text-gray-400">
      © <%= Time.current.year %> Book Library. All rights reserved.
    </div>
  </div>
</footer>
