<div class="flex items-center justify-center min-h-screen bg-gray-100">
  <div class="w-full max-w-md bg-white p-6 rounded-lg shadow-md">

    <h1 class="text-2xl font-semibold text-center text-gray-700 mb-4">Forgot your password?</h1>

    <!-- Flash Messages -->
    <% if flash[:alert] %>
      <div class="mb-4 text-sm text-red-600 bg-red-100 p-3 rounded-md"><%= flash[:alert] %></div>
    <% end %>

    <!-- Password Reset Form -->
    <%= form_with url: password_path, class: "space-y-4" do |form| %>

      <div>
        <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username",
          placeholder: "Enter your email address",
          value: params[:email],
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= form.submit "Email reset instructions", 
          class: "w-full cursor-pointer bg-gray-900 text-white py-2 px-4 rounded-lg shadow-md hover:bg-blue-700 transition" %>
      </div>
    <p class="text-center text-gray-800 mt-4">
      <%= link_to "Login", new_session_path, class: "text-blue-600 hover:underline" %>
    </p>
    <% end %>

  </div>
</div>
